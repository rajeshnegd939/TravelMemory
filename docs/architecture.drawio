        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;TravelMemory&lt;/b&gt;&lt;br&gt;Deployment architecture" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;• App servers accept HTTP only from alb-sg&lt;br&gt;• SSH (22) allowed only from admin IP&lt;br&gt;• Atlas access list has only the 2 backend IPs&lt;br&gt;• DB credentials live in .env (not in Git)&lt;br&gt;&lt;br&gt;&lt;b&gt;Scaling&lt;/b&gt;&lt;br&gt;• 2 frontend + 2 backend servers in 2 AZs&lt;br&gt;• ALB health checks: / and /health" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;spacing=10;rounded=1;strokeColor=#AAB7B8;fillColor=#F8F9FA;" vertex="1" parent="1">
